{
  "name": "bilig_ft",
  "private": true,
  "version": "0.1.0",
  "description": "Bilig client — trilingual 3D STEM viewer (Vite + React + react-three-fiber + PWA).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "contract:hash": "node scripts/contract-hash.mjs",
    "dev:mock": "VITE_MOCK=1 vite",
    "size": "node scripts/size-check.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "check": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "dependencies": {
    "@bilig/content-model": "*",
    "@bilig/permissions": "*",
    "@bilig/scene-core": "*",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-query": "^5.104.3",
    "dexie": "^4.4.6",
    "i18next": "^23.16.4",
    "minisearch": "^7.1.0",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.27.0",
    "three": "^0.169.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.3.3",
    "tailwindcss": "4.1.18",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
